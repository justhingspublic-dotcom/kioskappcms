<?xml version="1.0" encoding="utf-8"?>
<!-- IIS 站台根目錄（D:\WebSite\JustDisplay）用：把該網域的流量反向代理到同機的 Node :3000。
     前提：IIS 已裝 URL Rewrite + ARR，且 ARR 的 Server Proxy Settings 已 Enable proxy。
     不設 X-Forwarded-Proto（2026-09-08 拿掉：沒在 URL Rewrite 加允許變數會整站 500）；程式用 .env 的 PUBLIC_URL 組對外網址，不需要它。 -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- 後台圖片影片上傳上限 500MB -->
        <requestLimits maxAllowedContentLength="524288000" />
        <!-- Node 程式和 IIS 站台同一個資料夾：這些不能被 IIS 當靜態檔給出去 -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="uploads" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
