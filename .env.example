DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=KioskAdmin
# 開發機建議用獨立資料庫（例如 KioskAdminDev，啟動時自動建立），設定、帳號、機器清單才不會跟正式站混在一起
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEVICE_KEY=
# 根網址「後台入口清單」前面那層登入的帳密（只在有設 BASE_PATH 時用到；留空＝入口頁不擋）
PORTAL_USERNAME=
PORTAL_PASSWORD=
# 站台品牌（2026-09-10 起同一份程式碼跑多個客戶站台）：SITE_NAME＝客戶名稱（後台標題、登入頁、入口卡片；沒設＝卓也小屋）
# SITE_LOGO＝登入頁橫式 logo，public/ 底下的相對路徑（沒設＝img/joye-logo.png；設成空字串＝沒有客戶 logo，改顯示公司 J 標＋客戶名稱）
# SITE_NAME=揚昇高爾夫球場
# SITE_LOGO=
# SITE_THEME＝站台主題色檔 public/themes/<名稱>.css（sunrise＝綠 #2E6F40；沒設＝style.css 預設的藍）
# SITE_THEME=sunrise
# 播放頁預設機器名：網址沒帶 ?device= 時用這個名字登錄。所有沒有 App 的螢幕開同一個網址＝同一台機器、同一畫面；
# 要讓某面螢幕不同，第一次開時帶 ?device=名字。沒設＝播放頁網址一定要帶 ?device=
# PLAY_DEFAULT_DEVICE=展示機
# 根網址入口清單的卡片：「路徑=名稱;路徑=名稱」，只有送出根網址的那個實例（正式站＝joye）要設；沒設＝只列自己
# PORTAL_SITES=/joye=卓也小屋;/sunrise=揚昇高爾夫球場
# 本機同時跑第二個站台：另存一份設定檔（例 .env.sunrise），啟動時 ENV_FILE=.env.sunrise node src/server.js
# 後台掛在哪個子路徑（正式站＝/joye，根網址留給未來各後台的統一入口；留空＝掛在根）
BASE_PATH=
# 對外上線後的網址（顯示在後台側欄「機器連線資訊」，機器就填這個；要含子路徑，例 https://justdisplay.justhings.com.tw/joye；留空＝用瀏覽器目前連到的位址）
PUBLIC_URL=

# 上傳檔資料夾（選填）：沒設＝專案底下的 uploads。開發機可指到正式站的 uploads 網路共用，兩邊圖片只存一份
# UPLOAD_DIR=\\192.168.1.82\D$\WebSite\JustDisplay\KioskAdmin\uploads

# 系統 log（2026-09-10）：寫在 logs/app-YYYY-MM-DD.log，一天一檔。LOG_LEVEL＝debug|info|warn|error（沒設＝info，開發機建議 debug）
# LOG_DIR 可改存放位置（沒設＝專案底下的 logs）；LOG_KEEP_DAYS＝保留天數（沒設＝30）；LOG_STDOUT=1 強制同時印到終端機
LOG_LEVEL=info
# LOG_DIR=
# LOG_KEEP_DAYS=30

# 操作紀錄（DB 表 KioskAuditLog，後台無頁面）與機器事件（KioskDeviceEvent）保留天數（沒設＝180／90）
# AUDIT_KEEP_DAYS=180
# DEVICE_EVENT_KEEP_DAYS=90
